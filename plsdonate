local function SendWebhook(content)
    if not State.plsdonateWebhookEnabled or State.plsdonateWebhookUrl == "" then return end
    pcall(function()
        local payload = HttpService:JSONEncode({content = content})
        local req = (syn and syn.request or http_request or request)
        if req then
            req({
                Url = State.plsdonateWebhookUrl,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = payload
            })
        end
    end)
end

local function TeleportToServer(placeId, jobId)
    SendWebhook("🚀 Найден сервер с активным донатером! Перелетаю туда...")
    game:GetService("TeleportService"):TeleportToPlaceInstance(placeId, jobId, LocalPlayer)
end

local function CheckForDonators()
    local req = (syn and syn.request or http_request or request)
    if not req then return end
    
    local response = req({
        Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100",
        Method = "GET"
    })
    
    if response and response.Body then
        local data = HttpService:JSONDecode(response.Body)
        if data and data.data then
            for _, server in pairs(data.data) do
                if server.id ~= game.JobId and server.playing < server.maxPlayers then
                    -- Для PLS DONATE мы ищем сервера с разумным онлайном, где выше шанс найти донатера
                    -- Обычно это сервера на 30-50 человек
                    if server.playing > 15 then
                        TeleportToServer(game.PlaceId, server.id)
                        return true
                    end
                end
            end
        end
    end
    return false
end

