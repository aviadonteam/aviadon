local function SerializeColor(c)
    return {r=math.floor(c.R*255), g=math.floor(c.G*255), b=math.floor(c.B*255)}
end
local function DeserializeColor(t)
    if not t then return Color3.fromRGB(255,255,255) end
    return Color3.fromRGB(t.r or 255, t.g or 255, t.b or 255)
end

local function SaveConfig(name)
    local cfg = {
        speed = State.speed, jumpPower = State.jumpPower,
        gravity = State.gravityVal, collectionRadius = State.collectionRadius,
        timeOfDay = State.timeOfDay, fov = State.fov,
        espEnabled = State.espEnabled, espChams = State.espChams,
        espTracers = State.espTracers, espBoxes = State.espBoxes,
        espNametags = State.espNametags, espHealthBars = State.espHealthBars,
        espDistance = State.espDistance, espFillTransp = State.espFillTransp,
        espOutlineTransp = State.espOutlineTransp,
        espFillColor = SerializeColor(State.espFillColor),
        espOutlineColor = SerializeColor(State.espOutlineColor),
        espChamsColor = SerializeColor(State.espChamsColor),
        espTracerColor = SerializeColor(State.espTracerColor),
        espBoxColor = SerializeColor(State.espBoxColor),
        fullbright = State.fullbright, noFog = State.noFog,
        godMode = State.godMode, themeName = T.name or "dark"
    }
    Configs[name] = cfg
    if not table.find(savedConfigNames, name) then
        table.insert(savedConfigNames, name)
    end
    pcall(function()
        writefile("aviadons_cfg_"..name..".json", HttpService:JSONEncode(cfg))
        writefile("aviadons_cfg_list.json", HttpService:JSONEncode(savedConfigNames))
    end)
    return cfg
end

local function ApplyConfig(cfg)
    if not cfg then return end
    State.speed = cfg.speed or 16
    State.jumpPower = cfg.jumpPower or 50
    State.gravityVal = cfg.gravity or 196
    State.collectionRadius = cfg.collectionRadius or 50
    State.timeOfDay = cfg.timeOfDay or 14
    State.fov = cfg.fov or 70
    State.espFillTransp = cfg.espFillTransp or 0.5
    State.espOutlineTransp = cfg.espOutlineTransp or 0
    if cfg.espFillColor then State.espFillColor = DeserializeColor(cfg.espFillColor) end
    if cfg.espOutlineColor then State.espOutlineColor = DeserializeColor(cfg.espOutlineColor) end
    if cfg.espChamsColor then State.espChamsColor = DeserializeColor(cfg.espChamsColor) end
    if cfg.espTracerColor then State.espTracerColor = DeserializeColor(cfg.espTracerColor) end
    if cfg.espBoxColor then State.espBoxColor = DeserializeColor(cfg.espBoxColor) end
    if LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
        if hum then hum.WalkSpeed = State.speed; hum.JumpPower = State.jumpPower end
    end
    Workspace.Gravity = State.gravityVal
    Lighting.ClockTime = State.timeOfDay
    workspace.CurrentCamera.FieldOfView = State.fov
    for _, ref in pairs(sliderRefs) do
        if ref.key == "speed" then ref.obj.setValue(State.speed)
        elseif ref.key == "jumpPower" then ref.obj.setValue(State.jumpPower)
        elseif ref.key == "gravity" then ref.obj.setValue(State.gravityVal)
        elseif ref.key == "timeOfDay" then ref.obj.setValue(State.timeOfDay)
        elseif ref.key == "collectionRadius" then ref.obj.setValue(State.collectionRadius)
        elseif ref.key == "fov" then ref.obj.setValue(State.fov)
        end
    end
    if cfg.themeName then
        if Themes[cfg.themeName] then T = Themes[cfg.themeName]
        elseif customThemes[cfg.themeName] then T = customThemes[cfg.themeName] end
    end
end

local function LoadConfig(name)
    if Configs[name] then ApplyConfig(Configs[name]); return true end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile("aviadons_cfg_"..name..".json"))
    end)
    if ok and data then Configs[name] = data; ApplyConfig(data); return true end
    return false
end

local function LoadConfigList()
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile("aviadons_cfg_list.json"))
    end)
    if ok and data then
        for _, name in pairs(data) do
            if not table.find(savedConfigNames, name) then
                table.insert(savedConfigNames, name)
            end
        end
    end
end

local function SaveTheme(name, theme)
    local data = {
        name=name, main=SerializeColor(theme.main),
        secondary=SerializeColor(theme.secondary),
        accent=SerializeColor(theme.accent),
        text=SerializeColor(theme.text),
        glass=theme.glass, glassSecondary=theme.glassSecondary
    }
    customThemes[name] = theme
    pcall(function() writefile("aviadons_theme_"..name..".json", HttpService:JSONEncode(data)) end)
end

local function LoadTheme(name)
    if customThemes[name] then return customThemes[name] end
    local ok, data = pcall(function()
        return HttpService:JSONDecode(readfile("aviadons_theme_"..name..".json"))
    end)
    if ok and data then
        local theme = {
            name=name, main=DeserializeColor(data.main),
            secondary=DeserializeColor(data.secondary),
            accent=DeserializeColor(data.accent),
            text=DeserializeColor(data.text),
            glass=data.glass or 0.55, glassSecondary=data.glassSecondary or 0.65
        }
        customThemes[name] = theme
        return theme
    end
    return nil
end

