    Instance.new("UICorner",Arrow).CornerRadius=UDim.new(0,6)
    table.insert(allAccentBtns,Arrow)

    local DropFrame=Instance.new("Frame")
    DropFrame.BackgroundColor3=T.secondary
    DropFrame.BackgroundTransparency=0.1
    DropFrame.BorderSizePixel=0
    DropFrame.ZIndex=50
    DropFrame.Visible=false
    DropFrame.Parent=Aviadons
    Instance.new("UICorner",DropFrame).CornerRadius=UDim.new(0,8)
    local DStroke=Instance.new("UIStroke",DropFrame)
    DStroke.Thickness=1; DStroke.Color=Color3.fromRGB(255,255,255); DStroke.Transparency=0.75
    local DList=Instance.new("UIListLayout",DropFrame)
    DList.Padding=UDim.new(0,3)
    local DPad=Instance.new("UIPadding",DropFrame)
    DPad.PaddingTop=UDim.new(0,4); DPad.PaddingBottom=UDim.new(0,4)
    DPad.PaddingLeft=UDim.new(0,4); DPad.PaddingRight=UDim.new(0,4)

    local isOpen=false

    local function CloseDropdown()
        isOpen=false; DropFrame.Visible=false; Arrow.Text="▼"
    end

    local function OpenDropdown()
        isOpen=true; Arrow.Text="▲"
        for _, c in pairs(DropFrame:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        local opts=optionsGetter()
        if #opts==0 then
            local emptyLbl=Instance.new("TextButton",DropFrame)
            emptyLbl.Size=UDim2.new(1,0,0,28)
            emptyLbl.BackgroundTransparency=1
            emptyLbl.Text="empty"
            emptyLbl.TextColor3=Color3.fromRGB(150,150,150)
            emptyLbl.Font=Enum.Font.Gotham
            emptyLbl.TextSize=12; emptyLbl.ZIndex=51
        end
        for _, opt in pairs(opts) do
            local OptBtn=Instance.new("TextButton",DropFrame)
            OptBtn.Size=UDim2.new(1,0,0,30)
            OptBtn.BackgroundColor3=Color3.fromRGB(255,255,255)
            OptBtn.BackgroundTransparency=0.9
            OptBtn.Text=opt
            OptBtn.TextColor3=Color3.fromRGB(255,255,255)
            OptBtn.Font=Enum.Font.Gotham
            OptBtn.TextSize=13; OptBtn.ZIndex=51
            Instance.new("UICorner",OptBtn).CornerRadius=UDim.new(0,6)
            OptBtn.MouseButton1Click:Connect(function()
                Selected.Text=opt; callback(opt); CloseDropdown()
            end)
            OptBtn.MouseEnter:Connect(function()
                TweenService:Create(OptBtn,TweenInfo.new(0.15),{BackgroundTransparency=0.6}):Play()
            end)
            OptBtn.MouseLeave:Connect(function()
                TweenService:Create(OptBtn,TweenInfo.new(0.15),{BackgroundTransparency=0.9}):Play()
            end)
        end
        local itemCount=math.min(#opts,5)
        if itemCount==0 then itemCount=1 end
        DropFrame.Size=UDim2.new(0,180,0,itemCount*33+8)
        local absPos=Frame.AbsolutePosition
        local absSize=Frame.AbsoluteSize
        DropFrame.Position=UDim2.new(0,absPos.X+absSize.X-184,0,absPos.Y+absSize.Y+4)
        DropFrame.Visible=true
    end

    Arrow.MouseButton1Click:Connect(function()
        if isOpen then CloseDropdown() else OpenDropdown() end
    end)
    UserInputService.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 then
            if isOpen then
                local mp=UserInputService:GetMouseLocation()
                local dp=DropFrame.AbsolutePosition
                local ds=DropFrame.AbsoluteSize
                if not(mp.X>=dp.X and mp.X<=dp.X+ds.X and mp.Y>=dp.Y and mp.Y<=dp.Y+ds.Y) then
                    CloseDropdown()
                end
            end
        end
    end)

    return {refresh=function()
        if isOpen then CloseDropdown(); OpenDropdown() end
    end}
end

