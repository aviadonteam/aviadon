local character=LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local humanoidRootPart=character:WaitForChild("HumanoidRootPart")

local function processCoins()
    if not character or not humanoidRootPart then
        character=LocalPlayer.Character
        if character then humanoidRootPart=character:FindFirstChild("HumanoidRootPart") end
        return
    end
    local coinsFolder=Workspace:FindFirstChild("coins")
    local collectReq=ReplicatedStorage:FindFirstChild("CollectCoinRequest")
    if coinsFolder and collectReq then
        local closest,closestDist=nil,State.collectionRadius
        for _, coin in ipairs(coinsFolder:GetChildren()) do
            if coin:IsA("Model") and not coin:GetAttribute("Collected") then
                local p=coin.PrimaryPart or coin:FindFirstChildWhichIsA("BasePart")
                if p then 
                    local dist=(p.Position-humanoidRootPart.Position).Magnitude
                    if dist<closestDist then closestDist=dist; closest={coin=coin,position=p.Position} end
                end
            end
        end
        if closest then
            if closestDist>8 then
                humanoidRootPart.CFrame=CFrame.new(humanoidRootPart.Position+(closest.position-humanoidRootPart.Position).Unit*16)
            else
                collectReq:FireServer(closest.coin)
            end
        end
    end
end

